---
// src/components/carrusel.astro
import { slides } from './carruselData';
---

<div class="relative w-full max-w-275 my-10 mx-auto rounded-2xl overflow-hidden shadow-[0_10px_25px_rgba(0,0,0,0.15)]">
  
  <div class="flex flex-row w-full transition-transform duration-500 ease-[cubic-bezier(0.25,1,0.5,1)]" data-carousel-track>
    {slides.map((slide, index) => (
      <div 
        class="min-w-full box-border px-10 pt-10 pb-15 min-h-100 flex items-center text-white md:px-20 md:py-15 md:min-h-87.5" 
        style={`background-color: ${slide.color};`}
      >
        <div class="w-full max-w-150">
          <span class="bg-white/20 px-3 py-1.5 rounded-full text-[0.85rem] font-semibold uppercase tracking-wider">
            {slide.tag}
          </span>
          <h2 class="text-[1.8rem] md:text-[2.5rem] font-extrabold my-3.75 leading-tight">
            {slide.title}
          </h2>
          <p class="text-base md:text-[1.1rem] leading-relaxed mb-6.25 opacity-90">
            {slide.desc}
          </p>
          <a 
            href={slide.link} 
            class="inline-block bg-white text-black no-underline px-6 py-3 rounded-lg font-bold transition-all duration-200 hover:-translate-y-0.5 hover:shadow-[0_5px_15px_rgba(0,0,0,0.2)]"
          >
            Explorar ahora
          </a>
        </div>
      </div>
    ))}
  </div>

  <button 
    class="absolute top-1/2 -translate-y-1/2 left-5 bg-black/30 text-white border-none text-2xl w-11.25 h-11.25 rounded-full cursor-pointer hidden md:flex items-center justify-center transition-colors duration-200 z-10 hover:bg-black/60" 
    data-prev-btn 
    aria-label="Anterior"
  >
    ❮
  </button>
  <button 
    class="absolute top-1/2 -translate-y-1/2 right-5 bg-black/30 text-white border-none text-2xl w-11.25 h-11.25 rounded-full cursor-pointer hidden md:flex items-center justify-center transition-colors duration-200 z-10 hover:bg-black/60" 
    data-next-btn 
    aria-label="Siguiente"
  >
    ❯
  </button>

  <div class="absolute bottom-5 left-1/2 -translate-x-1/2 flex gap-2.5 z-10">
    {slides.map((_, index) => (
      <button 
        class={`w-3 h-3 rounded-full border-none cursor-pointer transition-all duration-300 ${index === 0 ? 'bg-white scale-120' : 'bg-white/40'}`} 
        data-dot={index} 
        aria-label={`Ir a diapositiva ${index + 1}`}
      ></button>
    ))}
  </div>
</div>

<script>
  function initCarousel() {
    const track = document.querySelector('[data-carousel-track]') as HTMLElement;
    const prevBtn = document.querySelector('[data-prev-btn]');
    const nextBtn = document.querySelector('[data-next-btn]');
    const dots = document.querySelectorAll('[data-dot]');
    
    if (!track || !prevBtn || !nextBtn) return;

    let currentIndex = 0;
    const totalSlides = dots.length;

    function updateCarousel(index: number) {
      currentIndex = index;
      track.style.transform = `translateX(-${currentIndex * 100}%)`;
      
      dots.forEach((dot, idx) => {
        if (idx === currentIndex) {
          dot.classList.add('bg-white', 'scale-120');
          dot.classList.remove('bg-white/40');
        } else {
          dot.classList.remove('bg-white', 'scale-120');
          dot.classList.add('bg-white/40');
        }
      });
    }

    nextBtn.addEventListener('click', () => {
      let nextIndex = currentIndex + 1;
      if (nextIndex >= totalSlides) nextIndex = 0; 
      updateCarousel(nextIndex);
    });

    prevBtn.addEventListener('click', () => {
      let prevIndex = currentIndex - 1;
      if (prevIndex < 0) prevIndex = totalSlides - 1; 
      updateCarousel(prevIndex);
    });

    dots.forEach((dot) => {
      dot.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        const index = parseInt(target.getAttribute('data-dot') || '0', 10);
        updateCarousel(index);
      });
    });
  }

  // Se ejecuta automáticamente al cargar el script en Astro
  initCarousel();
</script>