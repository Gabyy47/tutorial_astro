---

---

<header class="header-full-width">
  <div class="hero-banner">
    <div class="banner-content">
      
      <div class="banner-text">
        Piensa en <span class="text-yellow">Tecnología</span>, piensa en: <span class="text-bold-white">.hn</span>
      </div>
      
      <div class="banner-avatar">
        <img 
        src="Avatar.png" 
        alt="Avatar Ilustración" 
        class="avatar-img"
      />
      </div>
    </div>
  </div>
</header>

<style>
  .header-full-width {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    width: 100%;
    margin: 0;
    padding: 0;
    overflow-x: hidden;
  }

  .hero-banner {
    background: linear-gradient(135deg, #2b6cb0 0%, #319795 100%);
    width: 100%;
    padding: 60px 0;
    display: flex;
    justify-content: center;
  }

  .banner-content {
    width: 90%;
    max-width: 1200;
    margin: 0 auto;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
  }

  .banner-text {
    color: #ffffff;
    font-size: 1.8rem;
    font-weight: 400;
    max-width: 60%;
    line-height: 1.4;
  }

  .text-yellow {
    color: #ecc94b; 
    font-weight: 700;
  }

  .text-bold-white {
    font-weight: 800;
    font-size: 2.2rem;
    display: inline-block;
    vertical-align: middle;
    margin-left: 10px;
  }

  .banner-avatar {
    flex-shrink: 0;
  }

  .avatar-img {
    height: 180px;
    object-fit: contain;
    filter: drop-shadow(0px 8px 16px rgba(0,0,0,0.2)); 
  }

  @media (max-width: 2000px) {
    .banner-text {
      font-size: 1.6rem;
    }
    .text-bold-white {
      font-size: 2.4rem;
    }
    .avatar-img {
      height: 150px;
    }
  }

  @media (max-width: 768px) {
    .hero-banner {
      padding: 40px 0;
    }
    .banner-content {
      flex-direction: row;
      text align: center;
      gap: 30px;
    }
    .banner-text {
      max-width: 100;
      text-align: center;
    }
    .text-bold-white {
      font-size: 2.2rem;
      display: block;
      margin: 10px 0 0 0;
    }
    .avatar-img {
      height: 130px;
    }
  }
</style>