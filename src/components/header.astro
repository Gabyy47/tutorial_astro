---
// src/components/header.astro
import { headerImageData } from './headerData';
---

<header class="w-full m-0 p-0 overflow-x-hidden font-sans">
  <div class="w-full bg-linear-to-br from-[#2b6cb0] to-[#319795] py-10 md:py-15 flex justify-center">
    
    <div class="w-[90%] max-w-300 mx-auto flex flex-col md:flex-row justify-between items-center gap-7.5 md:gap-5">
      
      <div class="text-white text-[1.6rem] xl:text-[1.8rem] font-normal w-full md:max-w-[60%] leading-[1.4] text-center md:text-left">
        Piensa en <span class="text-[#ecc94b] font-bold">Tecnología</span>, piensa en: 
        <span class="block mt-2.5 font-extrabold text-[2.2rem] md:inline-block md:align-middle md:ml-2.5 md:mt-0 xl:text-[2.4rem]">
          .hn
        </span>
      </div>
      
      <div class="shrink-0">
        <img 
          src={headerImageData.src} 
          alt={headerImageData.alt} 
          class="h-32.5 md:h-37.5 xl:h-45 object-contain drop-shadow-[0_8px_16px_rgba(0,0,0,0.2)]"
        />
      </div>

    </div>
  </div>
</header>