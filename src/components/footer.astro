<style>
  /* CONFIGURACIÓN GENERAL DEL FOOTER */
  .main-footer {
    background-color: #f4f5f7; /* Gris muy claro idéntico a tu diseño */
    padding: 60px 20px 30px 20px;
    font-family: system-ui, -apple-system, sans-serif;
    color: #4a5568;
  }

  /* CONTENEDOR FLEX DE LAS COLUMNAS */
  .footer-container {
    display: flex;
    justify-content: space-between; /* Distribuye las columnas equitativamente */
    align-items: flex-start;
    max-width: 1200px;
    margin: 0 auto;
    gap: 30px;
  }

  /* DISEÑO DEL LOGO (.hn) */
  .footer-logo-section {
    flex: 1;
  }
  
  .logo-placeholder {
    display: flex;
    flex-direction: column;
  }

  .logo-main {
    font-size: 2.8rem;
    font-weight: 900;
    color: #1a202c;
    line-height: 1;
  }

  .logo-sub {
    font-size: 0.85rem;
    color: #718096;
    font-weight: 600;
    margin-top: 4px;
    letter-spacing: 0.5px;
  }

  /* ESTILOS DE LAS COLUMNAS DE TEXTO */
  .footer-column {
    flex: 1;
  }

  .footer-column h3 {
    color: #1a202c;
    font-size: 1.1rem;
    font-weight: 700;
    margin-top: 0;
    margin-bottom: 20px;
  }

  .footer-column ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer-column li {
    margin-bottom: 12px;
  }

  .footer-column a {
    color: #4a5568;
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
    transition: color 0.2s ease;
  }

  /* Efecto hover sutil para los enlaces del footer */
  .footer-column a:hover {
    color: #000000;
  }

  /* CONTENEDOR DE REDES SOCIALES */
  .social-links {
    display: flex;
    gap: 16px;
    align-items: center;
  }

  .social-links a {
    color: #1a202c;
    transition: transform 0.2s ease, color 0.2s ease;
  }

  .social-links a:hover {
    color: #4a5568;
    transform: scale(1.1); /* Efecto hover dinámico para los íconos */
  }

  /* DIVISOR Y COPYRIGHT */
  .footer-divider {
    border: 0;
    height: 1px;
    background-color: #e2e8f0;
    max-width: 1200px;
    margin: 40px auto 20px auto;
  }

  .footer-bottom {
    text-align: center;
    font-size: 0.9rem;
    color: #718096;
  }

  .footer-bottom a {
    color: #3182ce;
    text-decoration: none;
    font-weight: 600;
  }

  /* RESPONSIVE: Se adapta perfectamente a celulares */
  @media (max-width: 768px) {
    .footer-container {
      flex-direction: column; /* Cambia a fila única en móvil */
      gap: 40px;
      text-align: left;
    }
    
    .footer-logo-section, .footer-column {
      flex: none;
      width: 100%;
    }
  }
</style>