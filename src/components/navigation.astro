<style>
 
  .nav-container {
    display: flex;
    align-items: center;
    gap: 30px; 
    background-color: transparent; 
    padding: 10px 0;
  }

  .nav-item,
  .nav-container a,
  .dropdown {
    text-decoration: none !important;
    color: #000000 !important;
    font-weight: 700;
    font-size: 16px;
    cursor: pointer;
  }

  .dropdown {
    position: relative; 
    display: inline-block;
  }

  
  .dropdown-menu {
    position: absolute; 
    top: 95%;          
    left: 0;
    background-color: #ffffff; 
    min-width: 180px;
    border-radius: 8px;
    padding: 8px 0;
    box-shadow: 0px 4px 12px rgba(0, 0, 0, 0.15); 
    display: none; 
    z-index: 9999 !important; 
  }

  .dropdown:hover .dropdown-menu {
    display: block;
  }

  .dropdown-menu a {
    display: block;
    padding: 10px 20px;
    color: #2d3748 !important; 
    text-decoration: none !important;
    font-weight: 500;
    font-size: 15px;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .dropdown-menu a:hover {
    background-color: #edf2f7; 
    color: #000000 !important;
  }
</style>